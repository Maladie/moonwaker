<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.limelight.ui.StreamView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true"
        android:defaultFocusHighlightEnabled="false">
        <requestFocus />
    </com.limelight.ui.StreamView>

    <TextView
        android:id="@+id/performanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:layout_gravity="left"
        android:padding="2dp"
        android:textSize="10sp"
        android:typeface="monospace"
        android:gravity="left"
        android:background="#60000000"
        android:preferKeepClear="true"
        android:visibility="gone"
        android:text="..." />

    <!-- The link notice and the stream test's readout, top right, one under the other. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="27dp"
        android:layout_marginEnd="48dp"
        android:layout_marginRight="48dp"
        android:gravity="end"
        android:orientation="vertical">
        <TextView
            android:id="@+id/notificationOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:maxWidth="360dp"
            android:paddingLeft="13dp"
            android:paddingRight="13dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="12sp"
            android:textColor="@color/console_text_primary"
            android:lineSpacingMultiplier="1.15"
            android:background="@drawable/stream_link_notice"
            android:preferKeepClear="true"
            android:visibility="gone" />
        <com.limelight.ui.overlay.StreamTestHud
            android:id="@+id/autopilotHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_gravity="end"
            android:preferKeepClear="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The stream test's notice (mockup O5): top centre, a warning icon, the cause first. -->
    <TextView
        android:id="@+id/autopilotNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="27dp"
        android:maxWidth="500dp"
        android:paddingLeft="13dp"
        android:paddingRight="13dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textSize="11.5sp"
        android:textColor="@color/console_text_primary"
        android:lineSpacingMultiplier="1.15"
        android:background="@drawable/stream_link_notice"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <include layout="@layout/brightness_slider" />

    <LinearLayout
        android:id="@+id/discordDockView"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_gravity="right|top"
        android:layout_marginTop="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginEnd="18dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/discord_dock_glass"
        android:alpha="1"
        android:elevation="8dp"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <com.limelight.console.DiscordDmToastView
        android:id="@+id/discordDmToastView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|top"
        android:layout_marginTop="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginEnd="18dp"
        android:preferKeepClear="true" />

    <com.limelight.ui.overlay.OverlayMenuView
        android:id="@+id/overlayMenuView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:defaultFocusHighlightEnabled="false"
        android:preferKeepClear="true"
        android:visibility="gone" />

</merge>
